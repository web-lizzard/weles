# Classic GitHub PAT with read:packages — used by the devcontainer to install @web-lizzard/ordo.
# Fine-grained tokens do not work with GitHub Packages; keep this separate from any runtime GitHub token.
GITHUB_PACKAGES_TOKEN=ghp_your_token_here

# Dev-only Postgres in the devcontainer compose stack — not a secret.
DATABASE_URL=postgresql+asyncpg://weles:weles@postgres:5432/weles

# Langfuse hosted MCP (see README). Base64 of "pk-lf-...:sk-lf-..." with no trailing newline:
#   echo -n "pk-lf-xxx:sk-lf-xxx" | base64 -w 0
LANGFUSE_MCP_AUTH=your_base64_public_colon_secret
