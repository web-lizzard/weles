    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "backend-static", "integration_id": 15368 },
          { "context": "backend-unit", "integration_id": 15368 },
          { "context": "backend-bdd", "integration_id": 15368 },
          { "context": "tui-static", "integration_id": 15368 },
          { "context": "tui-unit", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    }
  ]
}
