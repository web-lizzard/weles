# Dev-only Postgres in the devcontainer compose stack — not a secret.
DATABASE_URL=postgresql+asyncpg://weles:weles@postgres:5432/weles

# OpenRouter API key — billed per embedding token. Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Capture agent: pydantic_ai (default, OpenRouter + CAPTURE_MODEL) or deterministic (no network, tests/CI).
# Pytest sets CAPTURE_AGENT_PROVIDER=deterministic (see tests/conftest.py).
CAPTURE_AGENT_PROVIDER=pydantic_ai

# OpenRouter chat model for capture (upstream prefix, e.g. openai/gpt-4o-mini).
CAPTURE_MODEL=openai/gpt-4o-mini

# Embedding backend: openrouter (default) or deterministic (no network, tests/CI).
# Pytest sets EMBEDDING_PROVIDER=deterministic and TRACING_ENABLED=false (see tests/conftest.py).
EMBEDDING_PROVIDER=openrouter

# OpenRouter model id with upstream prefix (e.g. openai/text-embedding-3-small).
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional vector size reduction; omit to use the model default (1536 for text-embedding-3-small).
# EMBEDDING_DIMENSIONS=256

# Export OpenTelemetry spans to Langfuse (set false to disable OTLP export locally).
# Pytest forces TRACING_ENABLED=false so the suite needs no Langfuse keys.
TRACING_ENABLED=true

# Langfuse Cloud project keys — https://cloud.langfuse.com → project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key

# OTLP traces URL (must end with /v1/traces). Base /api/public/otel alone returns 404.
# EU default; US: https://us.cloud.langfuse.com/api/public/otel/v1/traces
# LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces

# Langfuse MCP (Claude Code .mcp.json, Cursor .cursor/mcp.json): base64 of "public_key:secret_key".
# Generate locally (Linux); export the same value in your shell or root .env for editor MCP clients:
#   echo -n "pk-lf-xxx:sk-lf-xxx" | base64 -w 0
LANGFUSE_MCP_AUTH=your_base64_public_colon_secret
